{
  "expo": {
    "name": "Moyes Hub",
    "slug": "moyes-hub",
    "scheme": "moyeshub",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B0C",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B0C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.moyes.hub"
    },
    "android": {
      "package": "com.moyes.hub",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0C",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#F2A93B",
          "defaultChannel": "captura"
        }
      ],
      [
        "expo-system-ui",
        {
          "backgroundColor": "#0B0B0C"
        }
      ]
    ]
  }
}
